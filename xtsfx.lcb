-- LIB_SFX: xtsfx, rfxgen sound effects for xTalk. Hand-written; the C side is c/xtsfx.c.
-- The DLL keeps ONE current sound (24 numbers). Every handler reads or changes it.
library org.xtalk.xtsfx

metadata title is "xtsfx"
metadata author is "LIB_SFX"
metadata version is "0.1.0"

use com.livecode.foreign

-- Text results: the C side writes into its own buffer and answers the length;
-- this reads the bytes back one at a time. No C string ever crosses the boundary.
private foreign handler _xtsfx_ResultByte(in p0 as CInt) returns CInt binds to "c:xtsfx>xtsfx_ResultByte!cdecl"
private handler xtResult(in pLength as Number) returns String
	variable tOut as String
	variable tIndex as Number
	variable tCode as Number
	put "" into tOut
	put 0 into tIndex
	repeat while tIndex < pLength
		unsafe
			put _xtsfx_ResultByte(tIndex) into tCode
		end unsafe
		put the char with code tCode after tOut
		add 1 to tIndex
	end repeat
	return tOut
end handler

private foreign handler _xtsfx_Version() returns CInt binds to "c:xtsfx>xtsfx_Version!cdecl"
public handler xtsfx_Version() returns String
	variable tLength as Number
	unsafe
		put _xtsfx_Version() into tLength
	end unsafe
	return xtResult(tLength)
end handler

private foreign handler _xtsfx_Reset() returns nothing binds to "c:xtsfx>xtsfx_Reset!cdecl"
public handler xtsfx_Reset() returns nothing
	unsafe
		_xtsfx_Reset()
	end unsafe
end handler

private foreign handler _xtsfx_Presets() returns CInt binds to "c:xtsfx>xtsfx_Presets!cdecl"
public handler xtsfx_Presets() returns String
	variable tLength as Number
	unsafe
		put _xtsfx_Presets() into tLength
	end unsafe
	return xtResult(tLength)
end handler

private foreign handler _xtsfx_Preset(in p0 as ZStringNative, in p1 as CInt) returns CInt binds to "c:xtsfx>xtsfx_Preset!cdecl"
public handler xtsfx_Preset(in pPreset as String, in pSeed as Number) returns Boolean
	variable tOK as Number
	unsafe
		put _xtsfx_Preset(pPreset, pSeed) into tOK
	end unsafe
	return tOK is not 0
end handler

private foreign handler _xtsfx_Mutate(in p0 as CInt) returns nothing binds to "c:xtsfx>xtsfx_Mutate!cdecl"
public handler xtsfx_Mutate(in pSeed as Number) returns nothing
	unsafe
		_xtsfx_Mutate(pSeed)
	end unsafe
end handler

