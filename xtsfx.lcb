private foreign handler _xtsfx_ExportWav(in p0 as ZStringNative, in p1 as CInt, in p2 as CInt, in p3 as CInt) returns CInt binds to "c:xtsfx>xtsfx_ExportWav!cdecl"
public handler xtsfx_ExportWav(in pPath as String, in pRate as Number, in pBits as Number, in pChannels as Number) returns Number
	unsafe
		return _xtsfx_ExportWav(pPath, pRate, pBits, pChannels)
	end unsafe
end handler

end library
