public handler xtsfx_GetParam(in pName as String) returns Number
	unsafe
		return _xtsfx_GetParam(pName)
	end unsafe
end handler

private foreign handler _xtsfx_GetParams() returns CInt binds to "c:xtsfx>xtsfx_GetParams!cdecl"
public handler xtsfx_GetParams() returns String
	variable tLength as Number
	unsafe
		put _xtsfx_GetParams() into tLength
	end unsafe
	return xtResult(tLength)
end handler

